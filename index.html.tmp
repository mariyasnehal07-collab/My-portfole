                <li class="project-tech-item">Node.js</li>
                <li class="project-tech-item">Redis</li>
                <li class="project-tech-item">PostgreSQL</li>
              </ul>
              <div class="project-links">
                <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="project-link" aria-label="GitHub Repository for Distributed Cloud Task Manager">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                  Source Code
                </a>
                <a href="#" class="project-link project-link-primary" aria-label="Live Demo of Distributed Cloud Task Manager">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                  Live Demo
                </a>
              </div>
            </div>
          </article>

          <!-- Project Card 2 -->
          <article class="project-card">
            <div class="project-image-placeholder">
              <div class="placeholder-overlay">
                <span class="overlay-text">Project Screenshot Preview</span>
              </div>
            </div>
            <div class="project-card-body">
              <div class="project-meta">
                <span class="project-badge">API & Analytics</span>
              </div>
              <h3 class="project-card-title">Developer Metrics Analytics Engine</h3>
              <p class="project-card-desc">
                High-performance dashboard tracking Git commit velocities, pull request resolution times, 
                and automated deployment health telemetry.
              </p>
              <ul class="project-tech-list" aria-label="Technologies used">
                <li class="project-tech-item">TypeScript</li>
                <li class="project-tech-item">FastAPI</li>
                <li class="project-tech-item">Docker</li>
                <li class="project-tech-item">ClickHouse</li>
              </ul>
              <div class="project-links">
                <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="project-link" aria-label="GitHub Repository for Developer Metrics Analytics Engine">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                  Source Code
                </a>
                <a href="#" class="project-link project-link-primary" aria-label="Live Demo of Developer Metrics Analytics Engine">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                  Live Demo
                </a>
              </div>
            </div>
          </article>

          <!-- Project Card 3 -->
          <article class="project-card">
            <div class="project-image-placeholder">
              <div class="placeholder-overlay">
                <span class="overlay-text">Project Screenshot Preview</span>
              </div>
            </div>
            <div class="project-card-body">
              <div class="project-meta">
                <span class="project-badge">Open Source Library</span>
              </div>
              <h3 class="project-card-title">Lightweight Reactive State Store</h3>
              <p class="project-card-desc">
                Minimalist, zero-dependency state management library for browser applications under 1KB with 
                built-in undo/redo capabilities and devtools extension support.
              </p>
              <ul class="project-tech-list" aria-label="Technologies used">
                <li class="project-tech-item">JavaScript</li>
                <li class="project-tech-item">ES Modules</li>
                <li class="project-tech-item">Vitest</li>
                <li class="project-tech-item">Rollup</li>
              </ul>
              <div class="project-links">
                <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="project-link" aria-label="GitHub Repository for Lightweight Reactive State Store">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                  Source Code
                </a>
                <a href="#" class="project-link project-link-primary" aria-label="Live Demo of Lightweight Reactive State Store">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                  Live Demo
