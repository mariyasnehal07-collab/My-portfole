  <!-- Semi-transparent overlay backdrop for mobile sidebar -->
  <div class="sidebar-backdrop" id="sidebar-backdrop" aria-hidden="true"></div>

  <!-- ========================================================
       VERTICAL NAVIGATION BAR (LEFT SIDE OF SCREEN)
       - Fixed to the left edge on desktop/tablet
       - Features: Home, About Me, Skills, Timeline, Projects, Testimonials, Chat, Contact
       - Accessible, responsive, and pixel art styled
       ======================================================== -->
  <aside class="pixel-sidebar" id="sidebar-nav" aria-label="Primary Navigation">
    <div class="sidebar-inner">
      <!-- Mobile Close Button -->
      <div class="sidebar-close-row">
        <button id="sidebar-close-btn" class="sidebar-close-btn pixel-btn" type="button" aria-label="Close navigation menu">
          <span>&times; CLOSE</span>
        </button>
      </div>

      <!-- Player Brand / Header Profile Monogram -->
