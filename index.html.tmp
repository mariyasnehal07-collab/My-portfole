          </li>
          <li class="sidebar-nav-item" role="none">
            <a href="#timeline" class="sidebar-nav-link" role="menuitem">
              <span class="nav-arrow" aria-hidden="true">▶</span>
              <span class="nav-icon" aria-hidden="true">⏳</span>
