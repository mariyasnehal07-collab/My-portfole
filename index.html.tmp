    <!-- ========================================================
         SECTION 6: TESTIMONIALS (QUEST RECOMMENDATIONS)
         - Client, peer, and manager reviews & endorsements
         ======================================================== -->
    <section id="testimonials" class="section testimonials-section" aria-labelledby="testimonials-title">
      <div class="container">
        <header class="section-header">
          <span class="section-subtitle">GUILD REPUTATION</span>
          <h2 id="testimonials-title" class="section-title pixel-font">TESTIMONIALS</h2>
          <div class="section-title-bar"></div>
        </header>

        <div class="testimonials-grid">
          <article class="testimonial-card pixel-box">
            <div class="testimonial-stars" aria-label="5 out of 5 stars">⭐⭐⭐⭐⭐</div>
            <p class="testimonial-quote">
              "Mariya is a brilliant software engineer who brings extraordinary speed, clean architecture, and dependable rigor to every sprint."
            </p>
            <div class="testimonial-author">
              <span class="author-name pixel-font">Alex Rivera</span>
              <span class="author-role">Engineering Lead &bull; CloudTech</span>
            </div>
          </article>

          <article class="testimonial-card pixel-box">
            <div class="testimonial-stars" aria-label="5 out of 5 stars">⭐⭐⭐⭐⭐</div>
            <p class="testimonial-quote">
              "Outstanding full-stack versatility. Delivered resilient microservices ahead of schedule with flawless 99.9% uptime in production."
            </p>
            <div class="testimonial-author">
              <span class="author-name pixel-font">Sarah Chen</span>
              <span class="author-role">Senior Product Manager &bull; DevScale</span>
            </div>
          </article>

          <article class="testimonial-card pixel-box">
            <div class="testimonial-stars" aria-label="5 out of 5 stars">⭐⭐⭐⭐⭐</div>
            <p class="testimonial-quote">
              "Rare developer who pairs frontend aesthetic polish with robust distributed backend fundamentals. A joy to collaborate with!"
            </p>
            <div class="testimonial-author">
              <span class="author-name pixel-font">David Kumar</span>
              <span class="author-role">Staff Architect &bull; OpenInnovate</span>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ========================================================
         SECTION 7: CHAT (INTERACTIVE DIALOGUE / NPC HELPER)
         - Retro RPG companion dialogue & quick connect triggers
         ======================================================== -->
    <section id="chat" class="section chat-section" aria-labelledby="chat-title">
      <div class="container">
        <header class="section-header">
          <span class="section-subtitle">INTERACTIVE DIALOGUE</span>
          <h2 id="chat-title" class="section-title pixel-font">QUICK CHAT</h2>
          <div class="section-title-bar"></div>
        </header>

        <div class="chat-container pixel-box">
          <div class="chat-header">
            <div class="chat-npc-info">
              <img src="profile.jpeg" alt="Mariya Avatar" class="chat-npc-avatar">
              <div>
                <span class="npc-name pixel-font">MARIYA_BOT [ONLINE]</span>
                <span class="npc-subtext">Interactive Companion &bull; Instant Answers</span>
              </div>
            </div>
            <span class="chat-status-badge pixel-font">READY</span>
          </div>

          <div class="chat-messages" id="chat-messages-box">
            <div class="chat-msg bot-msg">
              <span class="msg-speaker pixel-font">MARIYA:</span>
              <p class="msg-bubble">
                "Greetings adventurer! Looking to discuss an engineering role, explore a collaboration, or inquire about my technical stack? Pick a topic or message me below!"
              </p>
            </div>
          </div>

          <div class="chat-quick-replies">
            <button type="button" class="quick-reply-btn pixel-btn" data-reply="Tell me about your tech stack!">⚡ Tech Stack</button>
            <button type="button" class="quick-reply-btn pixel-btn" data-reply="Are you available for full-time roles?">💼 Availability</button>
            <button type="button" class="quick-reply-btn pixel-btn" data-reply="Can we schedule a call?">📅 Schedule Call</button>
            <a href="#contact" class="quick-reply-btn pixel-btn pixel-btn-primary">✉️ Send Message</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================
         SECTION 8: CONTACT
         - Inquiry form and direct contact points
         - Email, social platforms, meeting scheduler placeholder
         ======================================================== -->
    <section id="contact" class="section contact-section" aria-labelledby="contact-title">
      <div class="container">
        <header class="section-header">
          <span class="section-subtitle">Reach Out</span>
          <h2 id="contact-title" class="section-title">Let's Connect</h2>
          <div class="section-title-bar"></div>
        </header>

        <div class="contact-grid">
          <!-- Contact Information & Context -->
          <div class="contact-info">
            <h3 class="contact-heading">Have a project or opportunity in mind?</h3>
            <p class="contact-text">
              I am always eager to discuss new software engineering roles, collaboration opportunities, 
              or open-source initiatives. Feel free to send a message or connect directly on social platforms!
            </p>

            <ul class="contact-direct-list">
              <li class="contact-direct-item">
                <span class="direct-icon" aria-hidden="true">✉️</span>
                <div>
                  <span class="direct-label">Email</span>
                  <a href="mailto:engineer@example.com" class="direct-link">engineer@example.com</a>
                </div>
              </li>
              <li class="contact-direct-item">
                <span class="direct-icon" aria-hidden="true">📍</span>
                <div>
                  <span class="direct-label">Location</span>
                  <span class="direct-link">San Francisco Bay Area / Remote</span>
                </div>
              </li>
              <li class="contact-direct-item">
                <span class="direct-icon" aria-hidden="true">💼</span>
                <div>
                  <span class="direct-label">Availability</span>
                  <span class="direct-link">Open to Full-Time & Contract Roles</span>
                </div>
              </li>
            </ul>
          </div>

          <!-- Contact Form Placeholder -->
          <div class="contact-form-card">
            <!-- PLACEHOLDER: Contact form handles submissions via backend or form service (e.g., Formspree) -->
            <form id="contact-form" class="contact-form" action="#" method="POST">
              <div class="form-group">
                <label for="sender-name" class="form-label">Full Name</label>
                <input type="text" id="sender-name" name="name" class="form-input" placeholder="e.g. Alex Smith" required>
              </div>

              <div class="form-group">
                <label for="sender-email" class="form-label">Email Address</label>
                <input type="email" id="sender-email" name="email" class="form-input" placeholder="alex@example.com" required>
              </div>

              <div class="form-group">
                <label for="sender-subject" class="form-label">Subject</label>
                <input type="text" id="sender-subject" name="subject" class="form-input" placeholder="Project Inquiry / Job Opportunity" required>
              </div>

              <div class="form-group">
                <label for="sender-message" class="form-label">Message</label>
                <textarea id="sender-message" name="message" class="form-textarea" rows="4" placeholder="Tell me about your project, timeline, or requirements..." required></textarea>
              </div>

              <button type="submit" id="submit-contact-btn" class="btn btn-primary btn-block">
                <span>Send Message</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>

  </main>

