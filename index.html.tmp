  <!-- ========================================================
       MAIN CONTENT WRAPPER
       ======================================================== -->
  <main id="main-content" class="main-content">

    <!-- ========================================================
         SECTION 1: HERO (PIXEL ART STYLE)
         - Pixel art retro gaming aesthetic
         - Uses provided background image: hero-bg.jpeg with adaptive theme overlays
         - Detects default browser theme via CSS Media Queries
         - Welcomes visitors with title, tagline, and retro quest dialogue
         ======================================================== -->
    <section id="hero" class="section hero-section pixel-hero" aria-labelledby="hero-title">
      <!-- Retro scanlines layer -->
      <div class="pixel-scanlines" aria-hidden="true"></div>

      <div class="container hero-container">
        <div class="hero-content pixel-hero-content">
          <!-- Pixel status badge with animated blinking heart and cursor -->
          <div class="pixel-status-badge">
            <span class="pixel-heart">♥</span>
            <span class="pixel-badge-text">STATUS: PLAYER 1 READY</span>
            <span class="pixel-blink">_</span>
          </div>

          <!-- Welcome Title in Pixel Font -->
          <h1 id="hero-title" class="hero-title pixel-title">
            <span class="pixel-greeting">&gt; HELLO, WORLD!</span>
            <span class="pixel-name-line">WELCOME, I'M <br><span class="pixel-name-highlight">MARIYA SNEHAL</span></span>
          </h1>

          <!-- Brief Tagline -->
          <p class="hero-tagline pixel-tagline">
            <span class="pixel-cursor-icon">▶</span> Software Engineer &bull; Full-Stack Builder &bull; Code Adventurer
          </p>

          <!-- Retro RPG Quest Dialogue Box -->
          <div class="pixel-dialogue-box">
            <div class="dialogue-top-bar">
              <span class="dialogue-speaker">MARIYA [LVL 99 DEV]</span>
              <span class="dialogue-stats">HP <span class="pixel-hearts">♥♥♥</span> 100%</span>
            </div>
            <p class="dialogue-message">
              "Small steps create big dreams! I build resilient web applications, distributed architectures, and clean code that turns ambitious ideas into reality."
            </p>
            <div class="dialogue-footer">
              <span class="dialogue-press-key">PRESS START TO EXPLORE</span>
              <span class="dialogue-arrow">▼</span>
            </div>
          </div>

          <!-- Pixel Action Buttons -->
          <div class="hero-cta-group pixel-cta-group">
            <a href="#projects" class="pixel-btn pixel-btn-primary">
              <span class="btn-pixel-icon">⚔️</span> VIEW QUESTS
            </a>
            <a href="#contact" class="pixel-btn pixel-btn-secondary">
              <span class="btn-pixel-icon">💬</span> GET IN TOUCH
            </a>
            <a href="Mariya_Snehal_Resume (1).pdf" class="pixel-btn pixel-btn-gold" download="Mariya_Snehal_Resume.pdf">
              <span class="btn-pixel-icon">📜</span> DOWNLOAD CV
            </a>
          </div>

          <!-- Pixel Social Links -->
          <div class="hero-social-links pixel-social-links">
            <span class="pixel-social-label">NETWORKS:</span>
            <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="pixel-link" aria-label="GitHub Profile">[GitHub]</a>
            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="pixel-link" aria-label="LinkedIn Profile">[LinkedIn]</a>
            <a href="mailto:mariyasnehal@example.com" class="pixel-link" aria-label="Email">[Email]</a>
          </div>
        </div>

        <!-- Pixel Hero Visual & Character Frame -->
        <div class="hero-visual pixel-hero-visual">
          <div class="pixel-frame-wrapper">
            <!-- 8-Bit Corner Brackets -->
            <div class="pixel-corner tl" aria-hidden="true"></div>
            <div class="pixel-corner tr" aria-hidden="true"></div>
            <div class="pixel-corner bl" aria-hidden="true"></div>
            <div class="pixel-corner br" aria-hidden="true"></div>

            <div class="pixel-frame-inner">
              <img src="profile.jpeg" alt="Mariya Snehal - Software Engineer" class="pixel-avatar-img">
              
              <!-- Retro HUD Overlay on avatar -->
              <div class="avatar-hud">
                <span class="hud-tag hud-class">CLASS: ENGINEER</span>
                <span class="hud-tag hud-exp">XP: 9999+</span>
              </div>
            </div>

            <!-- Floating Pixel Badges -->
            <div class="pixel-floating-badge badge-top">
              <span>⭐ JAVA &bull; WEB</span>
            </div>
            <div class="pixel-floating-badge badge-bottom">
              <span>💡 BETTER CODE</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================
         SECTION 2: ABOUT ME
         - Clean, minimalistic design with pixel art aesthetic
         - 16-bit pixel art avatar with character sheet specs
         - Bio, career highlights & personal interests
         ======================================================== -->
    <section id="about" class="section about-section" aria-labelledby="about-title">
      <div class="container">
        <header class="section-header">
          <span class="section-subtitle">CHARACTER PROFILE</span>
          <h2 id="about-title" class="section-title pixel-font">ABOUT ME</h2>
          <div class="section-title-bar"></div>
        </header>

        <div class="about-container">
          <!-- Left Column: Pixel Art Avatar & Specs -->
          <div class="about-visual-col">
            <div class="about-avatar-card pixel-box">
              <div class="about-avatar-header">
                <span class="avatar-tag pixel-font">SPRITE_V1.0</span>
                <span class="avatar-status-pill"><span class="status-dot"></span> ACTIVE</span>
              </div>

              <!-- Pixel Art Avatar Frame -->
              <div class="about-avatar-frame">
                <img src="pixel-avatar.jpg" alt="Mariya Snehal - Pixel Art Avatar" class="about-avatar-img" id="about-avatar-img">
                <div class="avatar-corner c-tl" aria-hidden="true"></div>
                <div class="avatar-corner c-tr" aria-hidden="true"></div>
                <div class="avatar-corner c-bl" aria-hidden="true"></div>
                <div class="avatar-corner c-br" aria-hidden="true"></div>
              </div>

              <!-- Quick Character Sheet Specs -->
              <div class="character-specs">
                <div class="spec-row">
                  <span class="spec-key pixel-font">ROLE:</span>
                  <span class="spec-val">Software Engineer</span>
                </div>
                <div class="spec-row">
                  <span class="spec-key pixel-font">LOCATION:</span>
                  <span class="spec-val">San Francisco, CA / Remote</span>
                </div>
                <div class="spec-row">
                  <span class="spec-key pixel-font">DEGREE:</span>
                  <span class="spec-val">B.S. in Computer Science</span>
                </div>
                <div class="spec-row">
                  <span class="spec-key pixel-font">FOCUS:</span>
                  <span class="spec-val spec-highlight">Full-Stack & Cloud</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column: Bio, Career Highlights & Personal Interests -->
          <div class="about-content-col">
            <div class="about-bio-box">
              <h3 class="about-lead pixel-font">
                Crafting clean, resilient, and human-centered software solutions.
              </h3>
              <p class="about-p">
                Hi, I'm <strong>Mariya Snehal</strong> — a software engineer passionate about writing clean, maintainable code 
                and engineering dependable systems. With a strong foundation in computer science and full-stack software development, 
                I bridge the gap between intuitive user experiences and scalable server-side architecture.
              </p>
              <p class="about-p">
                Whether architecting distributed microservices, optimizing database transactions, or refining interactive 
                frontends, my development philosophy centers on resilience, developer velocity, and measured user impact.
              </p>
            </div>

            <!-- Career Highlights & Personal Interests (Clean Minimalist Cards) -->
            <div class="about-cards-grid">
              <!-- Career Highlights Card -->
              <div class="about-feature-card pixel-box">
                <div class="feature-header">
                  <span class="feature-icon" aria-hidden="true">🏆</span>
                  <h4 class="feature-title pixel-font">CAREER HIGHLIGHTS</h4>
                </div>
                <ul class="feature-list">
                  <li>
                    <strong class="feature-bullet">&bull; Scalable Architectures:</strong> 
                    Engineered microservices and APIs handling over 100k+ daily transactions with 99.9% uptime.
                  </li>
                  <li>
                    <strong class="feature-bullet">&bull; Performance Tuning:</strong> 
                    Cut API response latencies by 35% through Redis caching layers and schema optimizations.
                  </li>
                  <li>
                    <strong class="feature-bullet">&bull; Quality & Testing:</strong> 
                    Championed automated CI/CD pipelines and testing suites reaching 85%+ coverage.
                  </li>
                </ul>
              </div>

              <!-- Personal Interests Card -->
              <div class="about-feature-card pixel-box">
                <div class="feature-header">
                  <span class="feature-icon" aria-hidden="true">🎮</span>
                  <h4 class="feature-title pixel-font">PERSONAL INTERESTS</h4>
                </div>
                <ul class="feature-list">
                  <li>
                    <strong class="feature-bullet">&bull; Retro & Indie Games:</strong> 
                    Passionate about 16-bit pixel art, arcade game mechanics, and game design theory.
                  </li>
                  <li>
                    <strong class="feature-bullet">&bull; Open Source:</strong> 
                    Contributing to developer tooling, participating in tech hackathons, and writing tech blogs.
                  </li>
                  <li>
                    <strong class="feature-bullet">&bull; Beyond the Screen:</strong> 
                    Sci-fi literature enthusiast, pour-over coffee brewer, and curious urban explorer.
                  </li>
                </ul>
              </div>
            </div>

            <!-- Quantitative Stats Bar -->
            <div class="about-stats-bar">
              <div class="stat-pill pixel-box">
                <span class="stat-num pixel-font">4+</span>
                <span class="stat-desc">Years Coding</span>
              </div>
              <div class="stat-pill pixel-box">
                <span class="stat-num pixel-font">25+</span>
                <span class="stat-desc">Projects Shipped</span>
              </div>
              <div class="stat-pill pixel-box">
                <span class="stat-num pixel-font">10+</span>
                <span class="stat-desc">Cloud Deploys</span>
              </div>
              <div class="stat-pill pixel-box">
                <span class="stat-num pixel-font">99.9%</span>
                <span class="stat-desc">System Uptime</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================
         SECTION 3: SKILLS (ABILITY MATRIX & SKILL TREE)
         - Core Competencies: Programming Languages, Frameworks, Tools/DevOps, Communication Skills
         - Retro 8-bit progress bars, pixel icons, level badges & hover animations
         - Informative code comments explaining each skill representation
         ======================================================== -->
    <section id="skills" class="section skills-section" aria-labelledby="skills-title">
      <div class="container">
        <!-- Section Header -->
        <header class="section-header">
          <span class="section-subtitle">SKILL TREE & ABILITIES</span>
          <h2 id="skills-title" class="section-title pixel-font">CORE COMPETENCIES</h2>
          <div class="section-title-bar"></div>
        </header>

        <!-- Interactive Skill Category Filter Pills -->
        <div class="skills-filter-bar" role="tablist" aria-label="Filter skill categories">
          <button type="button" class="skill-filter-btn pixel-btn active" data-filter="all" role="tab" aria-selected="true">
            <span>[ALL SKILLS]</span>
          </button>
          <button type="button" class="skill-filter-btn pixel-btn" data-filter="languages" role="tab" aria-selected="false">
            <span>💻 LANGUAGES</span>
          </button>
          <button type="button" class="skill-filter-btn pixel-btn" data-filter="frameworks" role="tab" aria-selected="false">
            <span>⚡ FRAMEWORKS</span>
          </button>
          <button type="button" class="skill-filter-btn pixel-btn" data-filter="tools" role="tab" aria-selected="false">
            <span>🛠️ TOOLS & CLOUD</span>
          </button>
          <button type="button" class="skill-filter-btn pixel-btn" data-filter="communication" role="tab" aria-selected="false">
            <span>💬 COMMUNICATION</span>
          </button>
        </div>

        <div class="skills-matrix-grid">

          <!-- ========================================================
               CATEGORY 1: PROGRAMMING LANGUAGES
               Represents foundational syntax, memory handling & algorithmic fluency
               ======================================================== -->
          <article class="skill-card pixel-box" data-category="languages">
            <div class="skill-card-header">
              <div class="card-icon-wrap">
                <span class="skill-cat-icon" aria-hidden="true">💻</span>
              </div>
              <div class="card-header-text">
                <h3 class="skill-card-title pixel-font">PROGRAMMING LANGUAGES</h3>
                <span class="skill-card-level pixel-font">LVL 95 &bull; PRIMARY SPELLS</span>
              </div>
            </div>
            <p class="skill-card-summary">
              Core languages used to architect distributed algorithms, backend business logic, and resilient web experiences.
            </p>

            <div class="skill-bars-list">
              <!-- SKILL: Java
                   Represents core OOP principles, concurrent multithreading, and enterprise backend engineering -->
              <div class="skill-bar-item">
                <div class="skill-bar-info">
                  <span class="skill-name pixel-font"><span class="skill-arrow">▶</span> Java</span>
                  <span class="skill-exp-level pixel-font">92% <span class="badge-mini">LVL 92</span></span>
                </div>
                <div class="pixel-progress-track" aria-label="Java proficiency: 92%" role="progressbar" aria-valuenow="92" aria-valuemin="0" aria-valuemax="100">
                  <div class="pixel-progress-fill fill-accent" style="width: 92%;">
                    <div class="pixel-stripes"></div>
                  </div>
                </div>
                <span class="skill-sub-caption">OOP Architecture &bull; Multithreading &bull; JVM Tuning</span>
              </div>

              <!-- SKILL: JavaScript & TypeScript
                   Represents dynamic web programming, strict static typing, and scalable asynchronous frontends -->
              <div class="skill-bar-item">
                <div class="skill-bar-info">
                  <span class="skill-name pixel-font"><span class="skill-arrow">▶</span> TypeScript / JS (ES6+)</span>
                  <span class="skill-exp-level pixel-font">95% <span class="badge-mini">LVL 95</span></span>
                </div>
                <div class="pixel-progress-track" aria-label="TypeScript and JavaScript proficiency: 95%" role="progressbar" aria-valuenow="95" aria-valuemin="0" aria-valuemax="100">
                  <div class="pixel-progress-fill fill-cyan" style="width: 95%;">
                    <div class="pixel-stripes"></div>
                  </div>
                </div>
                <span class="skill-sub-caption">Type Safety &bull; Modern ESNext &bull; Event Loop Mastery</span>
              </div>

              <!-- SKILL: Python
                   Represents rapid prototyping, API microservices, automation scripts, and data manipulation -->
              <div class="skill-bar-item">
                <div class="skill-bar-info">
                  <span class="skill-name pixel-font"><span class="skill-arrow">▶</span> Python</span>
                  <span class="skill-exp-level pixel-font">88% <span class="badge-mini">LVL 88</span></span>
                </div>
                <div class="pixel-progress-track" aria-label="Python proficiency: 88%" role="progressbar" aria-valuenow="88" aria-valuemin="0" aria-valuemax="100">
                  <div class="pixel-progress-fill fill-gold" style="width: 88%;">
                    <div class="pixel-stripes"></div>
                  </div>
                </div>
                <span class="skill-sub-caption">Data Structures &bull; Automation &bull; Backend Scripting</span>
              </div>

              <!-- SKILL: SQL & Database Querying
                   Represents relational querying, ACID transaction consistency, and index tuning -->
              <div class="skill-bar-item">
                <div class="skill-bar-info">
                  <span class="skill-name pixel-font"><span class="skill-arrow">▶</span> SQL / Relational Data</span>
                  <span class="skill-exp-level pixel-font">86% <span class="badge-mini">LVL 86</span></span>
                </div>
                <div class="pixel-progress-track" aria-label="SQL proficiency: 86%" role="progressbar" aria-valuenow="86" aria-valuemin="0" aria-valuemax="100">
                  <div class="pixel-progress-fill fill-green" style="width: 86%;">
                    <div class="pixel-stripes"></div>
                  </div>
                </div>
                <span class="skill-sub-caption">Schema Design &bull; Complex Joins &bull; Index Optimization</span>
              </div>
            </div>

            <!-- Styled Skill Badges -->
            <div class="card-tags-footer">
              <span class="pixel-tag">Java SE</span>
              <span class="pixel-tag">TypeScript</span>
              <span class="pixel-tag">JavaScript</span>
              <span class="pixel-tag">Python 3</span>
              <span class="pixel-tag">PostgreSQL</span>
              <span class="pixel-tag">HTML5/CSS3</span>
            </div>
          </article>

          <!-- ========================================================
               CATEGORY 2: FRAMEWORKS & LIBRARIES
               Represents full-stack application frameworks, component architectures & reactive stores
               ======================================================== -->
          <article class="skill-card pixel-box" data-category="frameworks">
            <div class="skill-card-header">
              <div class="card-icon-wrap">
                <span class="skill-cat-icon" aria-hidden="true">⚡</span>
