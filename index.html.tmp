        <div class="sidebar-avatar-wrapper">
          <img src="profile.jpeg" alt="Mariya Snehal avatar" class="sidebar-avatar-img">
          <span class="player-status-dot" title="Player Online" aria-label="Status: Online"></span>
        </div>
        <div class="sidebar-brand-info">
          <span class="sidebar-badge pixel-font">PLAYER 1</span>
          <a href="#hero" class="sidebar-logo-text pixel-font" aria-label="Home">
            <span class="bracket">[</span>MS<span class="bracket">]</span>.DEV
          </a>
          <span class="sidebar-subtitle pixel-font">LVL 99 CS</span>
        </div>
      </div>

      <!-- Navigation Menu with 8-bit Icons & Arrow Indicators -->
      <nav class="sidebar-nav" aria-label="Vertical Site Navigation">
        <ul class="sidebar-nav-list" role="menubar">
          <li class="sidebar-nav-item" role="none">
            <a href="#hero" class="sidebar-nav-link active" role="menuitem" aria-current="page">
