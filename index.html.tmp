    <div class="mobile-topbar-container">
      <a href="#hero" class="brand-logo pixel-logo" aria-label="Mariya Snehal Portfolio Home">
        <span class="pixel-brand-bracket">[</span><span class="pixel-brand-accent">MS</span><span class="pixel-brand-bracket">]</span><span class="logo-text">.dev</span>
      </a>
      <div class="mobile-topbar-actions">
        <button id="mobile-theme-toggle" class="theme-toggle-btn pixel-toggle mobile-theme-btn" type="button" aria-label="Toggle Night Mode" aria-pressed="false" title="Switch Theme">
          <span class="theme-icon sun-icon" aria-hidden="true">☀️</span>
          <span class="theme-icon moon-icon" aria-hidden="true">🌙</span>
        </button>
        <button id="mobile-menu-toggle" class="mobile-menu-btn pixel-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="sidebar-nav">
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
        </button>
      </div>
